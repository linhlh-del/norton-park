# Chép thành .env.production (hoặc .env.local khi dev) rồi điền giá trị thật.
# Worker nhận lead (be/norton-park-lead-worker) — URL sau khi `npm run deploy`, kèm /lead
VITE_LEAD_ENDPOINT=https://norton-park-lead-worker.<tai-khoan>.workers.dev/lead
# Tên miền chính thức (canonical, sitemap, Open Graph) — không có / ở cuối
VITE_SITE_URL=https://norton-park-rho.vercel.app
# Google Tag Manager (để trống nếu chèn snippet GTM thẳng vào index.html)
VITE_GTM_ID=
# Mã xác minh Google Search Console (phương thức thẻ HTML) — chỉ phần content
VITE_GSC_VERIFICATION=
