{
  "name": "norton-park",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fonts": "node scripts/build-fonts.mjs",
    "images": "node scripts/optimize-images.mjs",
    "assets": "npm run fonts && npm run images",
    "predev": "npm run assets",
    "prebuild": "node scripts/fetch-cms.mjs && npm run assets",
    "cms:fetch": "node scripts/fetch-cms.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "extract:map": "node scripts/extract-location-map.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.13",
    "ttf2woff2": "^6.0.1",
    "vite": "^6.0.7"
  }
}
